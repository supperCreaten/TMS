	<sql id="selectOrderVo">
		select order_id, order_no, waybill_no, customer_name, order_status, order_source,
			transport_type, cargo_type, sender_name, sender_phone, origin, sender_address,
			receiver_name, receiver_phone, destination, receiver_address,
			plan_transport_duration,
			vehicle_type, vehicle_length, vehicle_count, billing_method,
			transport_fee, insurance_fee, packing_fee, loading_fee, transfer_fee, fuel_fee, service_fee, other_fee, total_fee,
			pay_cash, pay_prepaid, pay_cod, pay_period, pay_total,
			total_quantity, total_volume, total_weight,
			is_del, create_by, create_time, update_by, update_time, remark
		from tms_order
	</sql>

	<select id="selectOrderList" parameterType="com.tms.system.domain.dto.TmsOrderQuery" resultMap="TmsOrderVoResult">
		<include refid="selectOrderVo"/>
		where is_del = '0'
		<if test="orderNo != null and orderNo != ''">
			AND order_no like concat('%', #{orderNo}, '%')
		</if>
		<if test="waybillNo != null and waybillNo != ''">
			AND waybill_no like concat('%', #{waybillNo}, '%')
		</if>
		<if test="customerName != null and customerName != ''">
			AND customer_name like concat('%', #{customerName}, '%')
		</if>
		<if test="orderStatus != null and orderStatus != ''">
			AND order_status = #{orderStatus}
		</if>
		<if test="origin != null and origin != ''">
			AND origin like concat('%', #{origin}, '%')
		</if>
		<if test="destination != null and destination != ''">
			AND destination like concat('%', #{destination}, '%')
		</if>
		<if test="beginOrderTime != null">
			AND create_time &gt;= #{beginOrderTime}
		</if>
		<if test="endOrderTime != null">
			AND create_time &lt;= #{endOrderTime}
		</if>
		order by create_time desc
	</select>

	<select id="selectOrderById" parameterType="Long" resultMap="TmsOrderDetailResult">
		<include refid="selectOrderVo"/>
		where order_id = #{orderId} and is_del = '0'
	</select>

	<select id="selectOrderByOrderNo" parameterType="String" resultMap="TmsOrderResult">
		<include refid="selectOrderVo"/>
		where order_no = #{orderNo} and is_del = '0' limit 1
	</select>

	<insert id="insertOrder" parameterType="com.tms.system.domain.TmsOrder" useGeneratedKeys="true" keyProperty="orderId">
		insert into tms_order(
			<if test="orderNo != null and orderNo != ''">order_no,</if>
			<if test="waybillNo != null and waybillNo != ''">waybill_no,</if>
			<if test="customerName != null and customerName != ''">customer_name,</if>
			<if test="orderStatus != null and orderStatus != ''">order_status,</if>
			<if test="orderSource != null and orderSource != ''">order_source,</if>
			<if test="transportType != null and transportType != ''">transport_type,</if>
			<if test="cargoType != null and cargoType != ''">cargo_type,</if>
			<if test="senderName != null and senderName != ''">sender_name,</if>
			<if test="senderPhone != null and senderPhone != ''">sender_phone,</if>
			<if test="origin != null and origin != ''">origin,</if>
			<if test="senderAddress != null and senderAddress != ''">sender_address,</if>
			<if test="receiverName != null and receiverName != ''">receiver_name,</if>
			<if test="receiverPhone != null and receiverPhone != ''">receiver_phone,</if>
			<if test="destination != null and destination != ''">destination,</if>
			<if test="receiverAddress != null and receiverAddress != ''">receiver_address,</if>
			<if test="planTransportDuration != null">plan_transport_duration,</if>
			<if test="vehicleType != null and vehicleType != ''">vehicle_type,</if>
			<if test="vehicleLength != null and vehicleLength != ''">vehicle_length,</if>
			<if test="vehicleCount != null">vehicle_count,</if>
			<if test="billingMethod != null and billingMethod != ''">billing_method,</if>
			transport_fee, insurance_fee, packing_fee, loading_fee, transfer_fee,
			fuel_fee, service_fee, other_fee, total_fee,
			pay_cash, pay_prepaid, pay_cod, pay_period, pay_total,
			total_quantity, total_volume, total_weight,
			<if test="remark != null and remark != ''">remark,</if>
			is_del, create_by, update_by, create_time, update_time
		)values(
			<if test="orderNo != null and orderNo != ''">#{orderNo},</if>
			<if test="waybillNo != null and waybillNo != ''">#{waybillNo},</if>
			<if test="customerName != null and customerName != ''">#{customerName},</if>
			<if test="orderStatus != null and orderStatus != ''">#{orderStatus},</if>
			<if test="orderSource != null and orderSource != ''">#{orderSource},</if>
			<if test="transportType != null and transportType != ''">#{transportType},</if>
			<if test="cargoType != null and cargoType != ''">#{cargoType},</if>
			<if test="senderName != null and senderName != ''">#{senderName},</if>
			<if test="senderPhone != null and senderPhone != ''">#{senderPhone},</if>
			<if test="origin != null and origin != ''">#{origin},</if>
			<if test="senderAddress != null and senderAddress != ''">#{senderAddress},</if>
			<if test="receiverName != null and receiverName != ''">#{receiverName},</if>
			<if test="receiverPhone != null and receiverPhone != ''">#{receiverPhone},</if>
			<if test="destination != null and destination != ''">#{destination},</if>
			<if test="receiverAddress != null and receiverAddress != ''">#{receiverAddress},</if>
			<if test="planTransportDuration != null">#{planTransportDuration},</if>
			<if test="vehicleType != null and vehicleType != ''">#{vehicleType},</if>
			<if test="vehicleLength != null and vehicleLength != ''">#{vehicleLength},</if>
			<if test="vehicleCount != null">#{vehicleCount},</if>
			<if test="billingMethod != null and billingMethod != ''">#{billingMethod},</if>
			#{transportFee}, #{insuranceFee}, #{packingFee}, #{loadingFee}, #{transferFee},
			#{fuelFee}, #{serviceFee}, #{otherFee}, #{totalFee},
			#{payCash}, #{payPrepaid}, #{payCod}, #{payPeriod}, #{payTotal},
			#{totalQuantity}, #{totalVolume}, #{totalWeight},
			<if test="remark != null and remark != ''">#{remark},</if>
			'0', #{createBy}, #{updateBy}, sysdate(), sysdate()
		)
	</insert>

	<update id="updateOrder" parameterType="com.tms.system.domain.TmsOrder">
		update tms_order
		<set>
			<if test="waybillNo != null">waybill_no = #{waybillNo},</if>
			<if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
			<if test="orderStatus != null and orderStatus != ''">order_status = #{orderStatus},</if>
			<if test="orderSource != null and orderSource != ''">order_source = #{orderSource},</if>
			<if test="transportType != null and transportType != ''">transport_type = #{transportType},</if>
			<if test="cargoType != null and cargoType != ''">cargo_type = #{cargoType},</if>
			<if test="senderName != null and senderName != ''">sender_name = #{senderName},</if>
			<if test="senderPhone != null and senderPhone != ''">sender_phone = #{senderPhone},</if>
			<if test="origin != null and origin != ''">origin = #{origin},</if>
			<if test="senderAddress != null and senderAddress != ''">sender_address = #{senderAddress},</if>
			<if test="receiverName != null and receiverName != ''">receiver_name = #{receiverName},</if>
			<if test="receiverPhone != null and receiverPhone != ''">receiver_phone = #{receiverPhone},</if>
			<if test="destination != null and destination != ''">destination = #{destination},</if>
			<if test="receiverAddress != null and receiverAddress != ''">receiver_address = #{receiverAddress},</if>
			<if test="planTransportDuration != null">plan_transport_duration = #{planTransportDuration},</if>
			<if test="vehicleType != null">vehicle_type = #{vehicleType},</if>
			<if test="vehicleLength != null">vehicle_length = #{vehicleLength},</if>
			<if test="vehicleCount != null">vehicle_count = #{vehicleCount},</if>
			<if test="billingMethod != null and billingMethod != ''">billing_method = #{billingMethod},</if>
			<if test="transportFee != null">transport_fee = #{transportFee},</if>
			<if test="insuranceFee != null">insurance_fee = #{insuranceFee},</if>
			<if test="packingFee != null">packing_fee = #{packingFee},</if>
			<if test="loadingFee != null">loading_fee = #{loadingFee},</if>
			<if test="transferFee != null">transfer_fee = #{transferFee},</if>
			<if test="fuelFee != null">fuel_fee = #{fuelFee},</if>
			<if test="serviceFee != null">service_fee = #{serviceFee},</if>
			<if test="otherFee != null">other_fee = #{otherFee},</if>
			<if test="totalFee != null">total_fee = #{totalFee},</if>
			<if test="payCash != null">pay_cash = #{payCash},</if>
			<if test="payPrepaid != null">pay_prepaid = #{payPrepaid},</if>
			<if test="payCod != null">pay_cod = #{payCod},</if>
			<if test="payPeriod != null">pay_period = #{payPeriod},</if>
			<if test="payTotal != null">pay_total = #{payTotal},</if>
			<if test="totalQuantity != null">total_quantity = #{totalQuantity},</if>
			<if test="totalVolume != null">total_volume = #{totalVolume},</if>
			<if test="totalWeight != null">total_weight = #{totalWeight},</if>
			<if test="remark != null">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where order_id = #{orderId}
	</update>

	<update id="deleteOrderById" parameterType="Long">
		update tms_order set is_del = '1', update_time = sysdate() where order_id = #{orderId}
	</update>

	<update id="deleteOrderByIds" parameterType="Long">
		update tms_order set is_del = '1', update_time = sysdate()
		where order_id in
		<foreach collection="array" item="orderId" open="(" separator="," close=")">
			#{orderId}
		</foreach>
	</update>

</mapper>
