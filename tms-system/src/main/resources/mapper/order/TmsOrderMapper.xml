	<resultMap type="com.tms.system.domain.vo.TmsOrderVo" id="TmsOrderDetailResult" extends="TmsOrderVoResult">
		<collection property="cargoList" ofType="com.tms.system.domain.vo.TmsOrderCargoVo"
			column="order_id" select="com.tms.system.mapper.TmsOrderCargoMapper.selectCargoListByOrderId" />
	</resultMap>

	<resultMap type="com.tms.system.domain.TmsOrder" id="TmsOrderResult">
