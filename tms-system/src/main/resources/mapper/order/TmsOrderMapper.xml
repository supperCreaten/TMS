		<result property="origin"             column="origin"               />
		<result property="senderAddress"      column="sender_address"       />
		<result property="receiverName"       column="receiver_name"        />
		<result property="receiverPhone"      column="receiver_phone"       />
		<result property="destination"        column="destination"          />
		<result property="receiverAddress"    column="receiver_address"     />
		<result property="planTransportDuration"  column="plan_transport_duration"   />
		<result property="vehicleType"        column="vehicle_type"         />
		<result property="vehicleLength"      column="vehicle_length"       />
		<result property="vehicleCount"       column="vehicle_count"        />
		<result property="billingMethod"      column="billing_method"       />
		<result property="transportFee"       column="transport_fee"        />
		<result property="insuranceFee"       column="insurance_fee"        />
		<result property="packingFee"         column="packing_fee"          />
		<result property="loadingFee"         column="loading_fee"          />
		<result property="transferFee"        column="transfer_fee"         />
		<result property="fuelFee"            column="fuel_fee"             />
		<result property="serviceFee"         column="service_fee"          />
		<result property="otherFee"           column="other_fee"            />
		<result property="totalFee"           column="total_fee"            />
